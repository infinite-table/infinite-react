{
  "name": "infinite-table",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "description": "The most productive Data Table for React",
  "main": "index.js",
  "scripts": {
    "preinstall": "node scripts/only-pnpm.cjs",
    "postinstall": "node scripts/install-all.mjs --skip-root",
    "bundlewatch": "bundlewatch --config bundlewatch.config.json",
    "clean-deps": "node scripts/install-all.mjs --clean",
    "install-all": "pnpm install",
    "install-source": "pnpm -C source install",
    "install-www": "pnpm -C www install && pnpm -C www/dataserver install",
    "install-examples": "pnpm -C examples install",
    "install-devtools": "pnpm -C devtools install && pnpm -C devtools-ui install && pnpm -C devtools-www install",
    "clean": "pnpm run clean-deps && pnpm install",
    "dev": "npm-run-all --parallel www-serve:data examples-dev",
    "test": "npm-run-all --parallel www-serve:data examples-test",
    "test:ci": "pnpm run examples-test",
    "test:watch": "npm-run-all --parallel www-serve:data examples-dev-no-output examples-test:watch",
    "build:watch": "pnpm -C source run watch",
    "build": "npm-run-all build:react build:vue",
    "build:react": "pnpm -C source run build",
    "build:vue": "pnpm -C source run build:vue",
    "format": "npm-run-all --parallel source-format www-format",
    "lint": "npm-run-all --parallel www-lint",
    "build:all": "npm-run-all build www-build",
    "tsc": "npm-run-all source-tsc examples-tsc www-tsc",
    "tscw": "npm-run-all --parallel source-tscw examples-tscw www-tscw",
    "www": "npm-run-all --parallel www-serve:data www-dev",
    "ci:ts-check": "npm-run-all build --parallel examples-tsc www-tsc source-tsc:react source-tsc:vue",
    "ci:test:build": "pnpm run source-jest && pnpm run examples-test:build",
    "ci:test:run": "pnpm run examples-test:ci",
    "source-jest": "pnpm -C source run jest",
    "///": "///",
    "//": "// the above scripts are the most important ones",
    "////": "////",
    "source-tsc": "pnpm -C source run tsc",
    "source-tsc:react": "pnpm -C source run tsc:react",
    "source-tsc:vue": "pnpm -C source run tsc:vue",
    "source-tscw": "pnpm -C source run tscw",
    "source-format": "pnpm -C source run format",
    "examples-tsc": "pnpm -C examples run tsc",
    "examples-tscw": "pnpm -C examples run tscw",
    "examples-dev": "pnpm -C examples run dev",
    "examples-dev-no-output": "pnpm -C examples run dev-no-output",
    "examples-test": "pnpm -C examples run test",
    "examples-test:build": "pnpm -C examples run build && pnpm -C examples run build:vue",
    "examples-test:ci": "pnpm -C examples run ci:test",
    "examples-test:watch": "pnpm -C examples run test:watch",
    "www-dev": "pnpm -C www run dev",
    "www-build-dev": "pnpm -C www run build-dev",
    "www-build": "pnpm -C www run build && echo SUCCESS",
    "www-tsc": "pnpm -C www run tsc",
    "www-tscw": "pnpm -C www run tscw",
    "www-format": "pnpm -C www run format",
    "www-lint": "pnpm -C www run lint",
    "www-serve:data": "pnpm -C www run serve:data",
    "www-dataserver:install": "pnpm -C www/dataserver install",
    "test:debug": "pnpm -C examples run test:debug",
    "release:canary-nobump": "pnpm -C source run release:canary-nobump",
    "release:nobump": "pnpm -C source run release:nobump",
    "doctoc": "doctoc README.md && doctoc source/LICENSE.md",
    "generate-theme-vars": "node scripts/generate-theme-vars.cjs",
    "serve:functions": "npx netlify functions:serve",
    "worktree": "node scripts/worktree.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infinite-table/react-table.git"
  },
  "author": "InfiniteTable <admin@infinite-table.com> ",
  "bugs": {
    "url": "https://github.com/infinite-table/react-table/issues"
  },
  "homepage": "https://github.com/infinite-table/react-table#readme",
  "devDependencies": {
    "@tsconfig/recommended": "^1.0.8",
    "@types/estree": "^1.0.0",
    "@typescript-eslint/eslint-plugin": "^5.40.0",
    "@typescript-eslint/parser": "^5.40.0",
    "bundlewatch": "^0.4.0",
    "doctoc": "^2.0.0",
    "eslint": "^8.0.0",
    "next": "15.5.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.6.2",
    "prettier-eslint": "^13.0.0"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all"
  }
}
