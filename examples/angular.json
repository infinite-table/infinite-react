{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "packageManager": "pnpm"
  },
  "newProjectRoot": "",
  "projects": {
    "examples": {
      "projectType": "application",
      "root": "src/angular-app",
      "sourceRoot": "src/angular-app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "out-angular",
              "browser": ""
            },
            "index": "src/angular-app/index.html",
            "browser": "src/angular-app/main.ts",
            "tsConfig": "tsconfig.angular.json",
            "styles": ["src/angular-app/styles.css"],
            "assets": []
          },
          "configurations": {
            "production": {
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "examples:build:development"
          }
        }
      }
    }
  }
}
