{
  // Type checking (editor, `npm run tsc`): docs content and snippets are
  // checked against the library *source*, so they can use unreleased APIs and
  // no build is needed first. The Next.js build uses tsconfig.next.json.
  "extends": "../tsconfig.root.json",

  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "target": "es6",
    "allowJs": true,
    "jsx": "preserve",
    "rootDir": "..",
    "baseUrl": "./",
    "paths": {
      "react": ["../node_modules/@types/react"],
      "react-dom": ["../node_modules/react-dom"],
      "@www/*": ["./src/*"],
      "components/*": ["./src/components/*"],
      "@infinite-table/infinite-react": ["../source/src/index.tsx"],
      "contentlayer/generated": ["./.contentlayer/generated"]
    },
    // the source's sibling-file resolution (`./Foo` → `Foo.react.tsx`),
    // see source/tsconfig.react.json
    "moduleSuffixes": [".react", ""],
    "strictNullChecks": true
  },
  "include": [
    "next-env.d.ts",
    "app.d.ts",
    "../source/globals.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "-mdx-components.tsx",
    ".contentlayer/generated",
    "contentlayer.config.ts"
  ],
  // the docs demos and snippets have their own project: content/tsconfig.json
  // (and `out` is the static export, which holds a copied .ts worker file)
  "exclude": ["node_modules", "out", "content/docs", "content/blog"]
}
