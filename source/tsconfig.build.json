{
  "extends": "./tsconfig.json",
  // Angular siblings are checked by tsconfig.angular.json (ngc) only
  "exclude": ["node_modules", "src/**/*.angular.ts"],
  "compilerOptions": {
    "noEmit": true,
    "isolatedModules": false,
    "incremental": false,
    "composite": false,
    "rootDir": "./src"
  }
}
