{
  "extends": "../tsconfig.root.json",
  "include": ["src/**/*", "globals.d.ts"],
  "compilerOptions": {
    // TypeScript 6 no longer includes every @types package by default
    "types": ["jest", "node"],
    "noEmit": false,
    "sourceMap": true,
    "rootDir": ".",
    "noImplicitThis": true,
    "alwaysStrict": true,
    "resolveJsonModule": true,
    "composite": true,
    "incremental": true,
    "jsx": "react"
  },
  // Angular siblings need the Angular compiler (ngc) and its options:
  // they are checked by tsconfig.angular.json only
  "exclude": ["dist", "src/**/*.angular.ts"]
}
